{
  "name": "comet-network-quiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "bun --bun vite",
    "routes:generate": "bun --bun tsr generate",
    "lint": "bun run routes:generate && bun --bun eslint . --max-warnings 0",
    "lint:fix": "bun run routes:generate && bun --bun eslint . --fix --max-warnings 0",
    "typecheck": "bun run routes:generate && bun --bun tsc -p tsconfig.client.json && bun --bun tsc -p tsconfig.server.json && bun --bun tsc -p tsconfig.tools.json",
    "format": "bun --bun prettier . --write",
    "format:check": "bun --bun prettier . --check",
    "build": "bun run typecheck && bun --bun vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@elysia/eden": "1.4.10",
    "@elysia/static": "1.4.12",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@tanstack/react-router": "1.170.46",
    "elysia": "1.4.31",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/bun": "1.4.4",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8"
  }
}
